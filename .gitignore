# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Secrets & local config. Ignore ALL local env variants (they hold real
# tokens/keys) but keep the committed PLACEHOLDER example files tracked.
.env
.env.*
!.env.example
deploy/prod.env.example

# Private keys / credentials — never committed even if dumped to a file.
*.pem
*.p12
*.pfx
*.key
*.keystore
id_rsa*
id_ed25519*
*.jks

# SQLite databases (dev artifacts, never commit)
*.db
*.db-wal
*.db-shm
data/
dbg.db

# Tests / coverage
pytest-result.xml
coverage.xml
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Logs
*.log

# Binaries
deploy/cloudflared.exe
deploy/cloudflared

# OS
.DS_Store
Thumbs.db
backups/

# Dev junk / one-off scripts (never commit). Prod scripts are whitelisted.
*.err
*.out
out.txt
lt.err
launch.err
launch.out
scan_result.txt
_add_keys.py
existing_keys.txt
i18n_keys.txt
transform_await.py
bot/handlers/wallet_part1.py
bot/i18n_temp.py
scripts/*
!scripts/setup_foundry.sh
!scripts/deploy_vault.py
!scripts/deploy_outcome_market.py
!scripts/reencrypt_wallets.py
!scripts/validate_env.py
!scripts/smoke_onchain.py
!scripts/check_i18n.py

# Agent runtime artifacts
.agent_seen_news.json

# Foundry dependencies (restored via scripts/setup_foundry.sh)
contracts/lib/*
!contracts/lib/.gitkeep

# Foundry build artifacts
out/
cache/
